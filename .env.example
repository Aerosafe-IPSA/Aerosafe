# Copier ce fichier en .env puis remplacer les valeurs. Ne jamais committer .env.

# Base PostgreSQL (lue par docker-compose.yml)
POSTGRES_DB=aerosafe
POSTGRES_USER=aerosafe
POSTGRES_PASSWORD=changez-moi
POSTGRES_PORT=5432

# API OpenSky (optionnel : sans ces valeurs, accès anonyme limité)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
